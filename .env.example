# Frontend. Empty uses the same origin in production.
VITE_API_BASE=http://localhost:3000
VITE_LEADERBOARD_WS=wss://api.example.com/leaderboard

# Backend. Never expose these values through a VITE_ variable.
TELEGRAM_BOT_TOKEN=replace_in_your_secret_manager
JWT_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=https://play.example.com
AUTH_MAX_AGE_SECONDS=300
ADMIN_JWT_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
