# Browser-visible values. Never put secrets in a VITE_ variable.
VITE_API_BASE=http://127.0.0.1:3000
VITE_LEADERBOARD_WS=ws://127.0.0.1:3000/api/leaderboard/live

# Local API / production secret bindings.
PORT=3000
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
JWT_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:5173
AUTH_MAX_AGE_SECONDS=300
ADMIN_JWT_SECRET=replace_with_a_different_32_character_secret

# Server-only persistent infrastructure. Never expose these as VITE_ variables.
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=rediss://user:password@host:6379
POSTGRES_SSL=true
POSTGRES_TLS_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=30000
POSTGRES_IDLE_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=30000

# Real-infrastructure integration test. Use an isolated test database only.
# MTX_INTEGRATION_ALLOW_WRITE=false

# Production also requires provider bindings described in docs/DEPLOYMENT.md:
# ECONOMY_CONFIG, PAYMENT_VERIFIER,
# LEADERBOARD_PUBSUB, LEADERBOARD_WEBSOCKET and ADMIN_AUTH.
