{
  "name": "mtx-mini-app",
  "version": "2.0.0-mtx",
  "private": true,
  "engines": {
    "node": ">=22.6 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "node --experimental-strip-types --env-file=.env server/localServer.mjs",
    "server:start": "node --experimental-strip-types server/productionServer.mjs",
    "db:migrate": "node server/migrate.mjs",
    "build": "vite build --configLoader native",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test src/services/*.node.test.ts server/src/*.node.test.ts server/*.node.test.mjs",
    "test:integration": "node --experimental-strip-types server/integration/run.mjs",
    "server:check": "tsc -p server/tsconfig.json",
    "check": "tsc && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@ton/core": "0.62.0",
    "@tonconnect/ui-react": "3.0.0",
    "axios": "^1.7.9",
    "buffer": "^6.0.3",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.1",
    "redis": "^5.12.1",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3"
  }
}
